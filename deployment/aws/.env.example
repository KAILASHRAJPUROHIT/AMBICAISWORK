# Copy to .env on the AWS VM. Do not commit the populated file.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=replace-with-a-random-token

# Host data paths. Attach these to the persistent EBS volume before first start.
AGM_DATA_DIR=/srv/aradhana-gold-monitor/data
AGM_LOG_DIR=/srv/aradhana-gold-monitor/logs
AGM_RELEASE_TAG=prod
