# Copy to .env on the AWS VM. Do not commit the populated file.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# This file is shell-sourced by deploy-aws.sh - quote any value containing
# spaces or shell-special characters (see QR_REQUIRED_PRINTER below) or
# sourcing it will fail with a syntax error.
DOCUMENT_BRIDGE_TOKEN=replace-with-existing-bridge-token
AGENT_TOKEN=replace-with-new-long-random-agent-token
QR_REQUIRED_PRINTER="HP Laser MFP 355sdnw (05:32:A7)"
QR_DOCUMENT_RETENTION_DAYS=365
QR_DOCUMENT_QUEUE_MINUTES=30
MAX_UPLOAD_MB=50

# Host data path. Attach this to the persistent EBS volume before first start.
AIS_DATA_DIR=/srv/aradhana-print/data
AIS_BIND_PORT=8000
AIS_RELEASE_TAG=staging

# TLS front door (Caddy, separate from any other reverse proxy already on
# this box - see deployment/aws/Caddyfile's own header comment). Leave
# QR_SITE_ADDRESS as the real public domain even before DNS is cut over;
# Caddy retries ACME issuance harmlessly in the background until it
# resolves here, then picks up the cert within seconds - nothing to touch
# again at actual cutover time beyond the DNS change itself.
QR_SITE_ADDRESS=print.aradhanajewellers.com
QR_ACME_EMAIL=replace-with-a-real-address-for-Let's-Encrypt-expiry-notices
