# Copy to .env on the AWS VM. Do not commit the populated file.
# Generate tokens with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Sent by the desktop notifier popup as the X-Notifier-Token header.
NOTIFIER_TOKEN=replace-with-a-random-token

# Sent by the Android SMS-relay app as the X-Relay-Token header, when it
# POSTs to /api/sms-relay/ingest. Separate from NOTIFIER_TOKEN so a leaked
# notifier token can't be used to inject fake transactions.
RELAY_TOKEN=replace-with-a-different-random-token

# IMAP mailbox that receives forwarded bank SMS/email alerts.
IMAP_SERVER=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PORT=993
EMAIL_POLL_INTERVAL_SECONDS=5
NOTIFIER_ENABLE_EMAIL_POLL=1

APN_DATA_DIR=/srv/aradhana-payment-notifier/data
APN_RELEASE_TAG=prod
