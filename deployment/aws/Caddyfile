# TLS front door for the QR print server, entirely separate from MDM's own
# Caddy/Cloudflare-Tunnel setup on this same box - MDM publishes no host
# ports at all (tunnel-based), so 80/443 were free for this to take
# directly. Automatic Let's Encrypt cert issuance will simply retry
# harmlessly in the background until DNS for this domain actually points at
# this host; no action needed here at cutover time beyond the DNS change
# itself.
{
	email {$QR_ACME_EMAIL}
}

{$QR_SITE_ADDRESS} {
	encode gzip
	reverse_proxy qr-print-server:8000
}

# Gold rate monitor - deliberately unlisted (not linked from the public site),
# same posture as its previous Render URL. Reachable only if you know the
# exact hostname. See gold-rate-monitor/README.md for the full design notes.
{$AGM_SITE_ADDRESS} {
	encode gzip
	reverse_proxy gold-rate-monitor:8080
}

# Payment notifier (bank-activity backend for the desktop popup + Android
# SMS relay). Unlisted; auth is per-request (NOTIFIER_TOKEN/RELAY_TOKEN
# headers), not network position, since this is now public.
{$APN_SITE_ADDRESS} {
	encode gzip
	reverse_proxy payment-notifier:8000
}
