<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Filled shield, gradient navy-to-accent so it reads as a distinct mark rather than a flat
         system-default outline. -->
    <path android:pathData="M54,20 L78,30 L78,52 C78,70 68,82 54,90 C40,82 30,70 30,52 L30,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="20"
                android:endX="78" android:endY="90"
                android:startColor="#1D5FCC"
                android:endColor="#0B3D91" />
        </aapt:attr>
    </path>
    <!-- Thin accent rim so the shield separates from the adaptive-icon background at small sizes. -->
    <path
        android:pathData="M54,20 L78,30 L78,52 C78,70 68,82 54,90 C40,82 30,70 30,52 L30,30 Z"
        android:fillColor="#00000000"
        android:strokeColor="#22D3C7"
        android:strokeWidth="1.6" />
    <!-- Checkmark: "verified / protected device," the actual product idea, instead of an empty
         shield silhouette. -->
    <path
        android:pathData="M42,54 L50,62 L67,43"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
