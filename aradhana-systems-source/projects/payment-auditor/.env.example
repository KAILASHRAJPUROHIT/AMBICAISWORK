# Aradhana Payment Auditor Environment Configuration

# Database Configuration
DATABASE_URL=sqlite:///./aradhana_dev.db

# API Security
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# IMAP Email Polling Configuration (for Bank Alerts)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_bank_alerts@example.com
IMAP_PASSWORD=your_app_password
IMAP_FOLDER=INBOX

# OCR Configuration
OCR_ACCELERATION=auto # cpu, cuda, or auto