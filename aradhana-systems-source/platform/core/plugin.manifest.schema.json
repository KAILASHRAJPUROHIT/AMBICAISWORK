{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIS Plugin Manifest",
  "type": "object",
  "required": ["schema_version", "id", "display_name", "version", "owner_project", "contracts", "runtime", "ota"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "display_name": {"type": "string", "minLength": 3, "maxLength": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "owner_project": {"type": "string"},
    "contracts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime": {
      "type": "object",
      "required": ["kind", "interactive"],
      "properties": {"kind": {"enum": ["service", "scheduled-task", "user-session-agent", "library"]}, "interactive": {"type": "boolean"}}
    },
    "ota": {"type": "object", "required": ["target", "rollback"], "properties": {"target": {"type": "string"}, "rollback": {"type": "string"}}}
  },
  "additionalProperties": false
}
