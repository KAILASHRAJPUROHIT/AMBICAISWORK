# Development only. Do not commit real values.
AIS_ENVIRONMENT=development
AIS_DATABASE_URL=sqlite:///./data/ais-cloud.db
AIS_AGENT_TOKEN=replace-with-a-long-random-agent-token
AIS_OWNER_TOKEN=replace-with-a-long-random-owner-token
# Temporary bootstrap only. Production must use Key Vault secrets and a non-default admin password.
AIS_ADMIN_CREDENTIAL_HASH=sha256-of-lowercase-username-colon-password
AIS_SESSION_SECRET=replace-with-a-long-random-session-secret
AIS_ALLOWED_ORIGINS=https://ais.aradhanajewellers.com
