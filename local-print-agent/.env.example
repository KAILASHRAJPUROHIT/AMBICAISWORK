# Copy to .env and fill in real values. Never commit the real .env.
# Get TENANT_SLUG and AGENT_API_KEY from your business's /setup page.

CLOUD_SERVER_URL=https://your-ambic-smartqr-server.example.com
SUMATRA_PATH=C:\Path\To\SumatraPDF.exe

TENANT_SLUG=your-business-slug
AGENT_API_KEY=paste-the-agent-api-key-from-setup-here

# Optional fallback only — once the agent has run at least once, set the
# real default printer from the admin panel's Printer section instead. The
# agent refuses to print anywhere that isn't the admin-selected printer.
PRINTER_NAME=
