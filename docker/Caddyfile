# Edge for MDMesh. Serves the SPA and reverse-proxies the API/files/wake-socket to the server.
# SITE_ADDRESS is set by the setup wizard:
#   own-domain  → "mdm.example.com" (Caddy auto-provisions + renews a Let's Encrypt cert)
#   cloudflare  → ":80" (Cloudflare terminates TLS; cloudflared connects to this internally)
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip

	# Canonical agent-APK URL: /files/agent.apk works on BOTH deployment shapes (native serves a
	# real file from Tomcat; here it's the supervisor's sha256-verified release mirror — the same
	# upstream as /update/agent.apk, which stays below for back-compat). The exact-path matcher
	# outranks the /files/* → server route (Caddy sorts handles longest-path-first), so this must
	# stay more specific than @backend.
	handle /files/agent.apk {
		rewrite * /update/agent.apk
		reverse_proxy supervisor:9000
	}

	# API, uploaded files, and the agent wake WebSocket → the Tomcat server. reverse_proxy
	# upgrades WebSockets automatically, so /agent/ws works without extra config.
	@backend path /rest/* /files/* /agent/ws/*
	handle @backend {
		reverse_proxy server:8080
	}

	# Updater status + recovery page → the decoupled supervisor (always up, independent of the
	# server), so "update available" + recovery stay reachable even mid-update.
	handle /update/* {
		reverse_proxy supervisor:9000
	}
	handle /recovery* {
		reverse_proxy supervisor:9000
	}

	# Everything else is the single-page app.
	# index.html (and every non-asset path that falls back to it) must be revalidated on each load, otherwise a
	# browser keeps an old copy for hours and an open console never sees a new release. The hashed files under
	# /assets/ never change, so they are cached for a year.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page {
			not path /assets/*
		}
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# If the server (API) is down/erroring, fall back to the supervisor's recovery page.
	handle_errors {
		reverse_proxy supervisor:9000
	}
}
