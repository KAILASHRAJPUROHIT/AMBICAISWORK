# AMBIC Payment Auditor local/pilot configuration
#
# Do not set DATABASE_URL for normal tenant-separated operation. It is a
# test/debug override that intentionally maps every tenant to one database.
# DATABASE_URL=sqlite:///./temporary_test.db

# Replace all example values. Production secrets belong in the platform
# secret store, never in this file or a container image.
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Bank/SMS/SMTP settings are configured per tenant during onboarding and
# stored in businesses/<slug>/profile.json in the current pilot architecture.
SMS_FORWARDER_SENDER=
BANK_ALERT_FORWARDER=

# Optional document-processing acceleration.
OCR_ACCELERATION=auto
