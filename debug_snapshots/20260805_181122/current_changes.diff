 @echo off
 REM ====== Auto Catalogue Tool ΓÇö Aradhana Jewellers ======
+setlocal enabledelayedexpansion
 cd /d "%~dp0"
 
+REM ΓöÇΓöÇ ComfyUI (Klein/Variant C local engine) ΓÇö start FIRST, tool waits on it ΓöÇΓöÇ
+REM Local generation is now the primary engine (cloud/browser engines are
+REM being sunset), so ComfyUI must be up before the tool is opened.
+echo Checking ComfyUI...
+netstat -ano | findstr ":8188" | findstr LISTENING >nul 2>&1
+if errorlevel 1 (
+    echo Starting ComfyUI backend - Aradhana workspace...
+    start "ComfyUI-Aradhana" /D "C:\Users\kaila\ComfyUI-Installs\Aradhana" ^
+        "C:\Users\kaila\ComfyUI-Installs\Aradhana\ComfyUI\.venv\Scripts\python.exe" ^
+        -s ComfyUI\main.py --feature-flag show_signin_button=true --enable-manager ^
+        --extra-model-paths-config "C:\Users\kaila\AppData\Roaming\Comfy Desktop\shared_model_paths.yaml" ^
+        --input-directory "C:\Users\kaila\ComfyUI-Shared\input" ^
+        --output-directory "C:\Users\kaila\ComfyUI-Shared\output"
+
+    echo Waiting for ComfyUI to come up (up to 120s)...
+    powershell -NoProfile -Command ^
+        "$deadline = (Get-Date).AddSeconds(120); while ((Get-Date) -lt $deadline) { try { $r = Invoke-WebRequest -Uri 'http://127.0.0.1:8188/system_stats' -UseBasicParsing -TimeoutSec 3; if ($r.StatusCode -eq 200) { exit 0 } } catch {}; Start-Sleep -Seconds 2 }; exit 1"
+    if errorlevel 1 (
+        echo   WARNING: ComfyUI did not respond within 120s - continuing anyway.
+    ) else (
+        echo   ComfyUI is up.
+    )
+) else (
+    echo ComfyUI already running on 8188
+)
+
+REM Open ComfyUI's own UI in a dedicated, persistent Chrome profile so it
+REM keeps auto-restoring the last-open Aradhana workflow across restarts.
+REM ComfyUI has no server-side "current workflow" concept ΓÇö the browser
+REM profile's own local storage is what remembers it, so reusing the same
+REM profile every launch is what keeps the right workspace open. First time
+REM only: open the "aradhana_klein_tests" workflow manually in this window.
+start "" "C:\Program Files\Google\Chrome\Application\chrome.exe" ^
+    --user-data-dir="%LOCALAPPDATA%\ComfyUIMonitorChrome" ^
+    --no-first-run --no-default-browser-check ^
+    --window-position=-32000,-32000 --window-size=1280,900 ^
+    http://127.0.0.1:8188
+
