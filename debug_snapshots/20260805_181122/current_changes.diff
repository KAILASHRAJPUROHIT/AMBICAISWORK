+def _write_variant_c_report(result, fin, category, label, out_dir):
+    """Auto-write a Category/Verdict/Reason record for every Variant C item
+    (handover ┬º15/┬º24: 'never treat clean output as proof of design fidelity',
+    'operator review mandatory'). No review UI exists yet, so every item is
+    recorded as VISUAL_REVIEW_REQUIRED (or a specific failure verdict) rather
+    than silently disappearing into the output folder unflagged."""
+    try:
+        if result.get('error') == 'REFERENCE_HASH_FAILED':
+            verdict, reason = 'REFERENCE_HASH_FAILED', f"Upload pixel-hash mismatch: {result.get('hash_detail') or 'unknown'}"
+        elif result.get('error'):
+            verdict, reason = 'INFERENCE_FAILED', str(result['error'])[:500]
+        elif not fin.get('ok'):
+            verdict, reason = 'INFERENCE_FAILED', str(fin.get('error') or 'finalise_output rejected the candidate')[:500]
+        elif result.get('shadow_check') == 'SHADOW_CHECK_FAIL':
+            verdict, reason = 'REJECTED_SHADOW', 'Shadow QA failed on both the default seed and the shadow-retry seed.'
+        else:
+            verdict, reason = 'VISUAL_REVIEW_REQUIRED', (
+                f"Variant C candidate generated (hash={result.get('hash_check')}, "
+                f"shadow={result.get('shadow_check')}, seed={result.get('seed')}); "
+                "pending operator review."
+            )
+        record = build_report_record(
+            category, verdict, reason, item_label=label, run_id=category,
+            edited_path=fin.get('output') or '', shadow_check=result.get('shadow_check') or '',
+            hash_check=result.get('hash_check') or '',
+            visible_piece_count=result.get('count'), relationship=result.get('relationship') or '',
+            seed=result.get('seed') or 19951995,
+        )
+        item_folder = os.path.join(out_dir, "_edit_reports", re.sub(r'[/\\:*?"<>|]', '_', str(label)))
+        os.makedirs(item_folder, exist_ok=True)
+        save_item_report(item_folder, record)
+        batch_folder = os.path.join(out_dir, "_edit_reports", "_batch")
+        os.makedirs(batch_folder, exist_ok=True)
+        upsert_batch_record(batch_folder, record)
+    except Exception as e:
+        print(f"[{ts()}] WARN: _write_variant_c_report failed for {label}: {e}")
+
